NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Optional real provider webhook. It receives email, resetToken, expiresAt and resetUrl.
# PASSWORD_RESET_WEBHOOK_URL=https://your-provider.example/reset-webhook
PASSWORD_RESET_TTL_MINUTES=30
# PayHere hosted checkout. Keep these values on the API only.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_NOTIFY_URL=https://api.example.com/api/v1/payments/payhere/notify
PAYHERE_MODE=sandbox
# Set these only for the one-time administrator bootstrap command, then remove them.
# ADMIN_INITIAL_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=
